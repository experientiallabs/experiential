{
  "name": "exp-code",
  "version": "0.1.0",
  "description": "Experiential's open-source coding and cowork agent, built on Pi's coding agent and served through the Experiential gateway.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/experientiallabs/experiential.git",
    "directory": "agent"
  },
  "keywords": [
    "coding-agent",
    "agent",
    "pi",
    "experiential",
    "cli"
  ],
  "bin": {
    "exp-code": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/runner/protocol.d.ts",
      "import": "./dist/runner/protocol.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "EXP_CODE_LIVE=1 vitest run src/live.test.ts",
    "bundle": "node scripts/bundle-runner.mjs",
    "prepack": "npm run build && npm run bundle"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@earendil-works/pi-coding-agent": "1.5.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
