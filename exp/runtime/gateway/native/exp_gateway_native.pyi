SQLiteValue = str | bytes | int | float | None

class NativeSQLiteCursor:
    """Bounded prepared-statement access through the shared native library."""

    @property
    def columns(self) -> list[str]: ...
    @property
    def rowcount(self) -> int: ...
    @property
    def lastrowid(self) -> int: ...
    def fetchone(self) -> tuple[SQLiteValue, ...] | None: ...
    def close(self) -> None: ...

class NativeSQLiteConnection:
    """SQLite authority reads sharing accounting's native library and lock bookkeeping."""

    def __init__(
        self,
        path: str | PathLike[str],
        busy_timeout_ms: int = 5000,
        mode: Literal["ro", "rw", "rwc"] = "rwc",
    ) -> None: ...
    def execute(
        self, sql: str, arguments: Sequence[SQLiteValue] | Mapping[str, SQLiteValue] = ()
    ) -> NativeSQLiteCursor: ...
    def executescript(self, sql: str) -> None: ...
    @property
    def in_transaction(self) -> bool: ...
    @property
    def total_changes(self) -> int: ...
    def backup(self, target: NativeSQLiteConnection) -> None: ...
    def close(self) -> None: ...

