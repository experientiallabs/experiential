# Anthropic direct (Opus 4.8)
ANTHROPIC_API_KEY=

# AWS Bedrock (Claude 4.8)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure OpenAI (GPT 5.5)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# OpenAI direct (GPT 5.5)
OPENAI_API_KEY=

# OpenRouter (serves pool candidates like GLM-5.2 / Kimi, priced from its own catalog)
OPENROUTER_API_KEY=

# Tinker (distillation: student sampling, training, and serving trained adapters)
TINKER_API_KEY=

# E2B sandboxes (distillation rollouts and optimizer/eval runs with the e2b backend)
E2B_API_KEY=
# Team compressor endpoint (self-hosted LLMLingua-2 on the H100 box). Only the
# `llmlingua2-endpoint` compressor needs these; every other compressor runs in-process.
# URL is the box's HTTPS endpoint; the token is generated on the box and handed out by
# whoever administers it. The endpoint serves a pinned self-signed certificate;
# WMO_COMPRESSOR_CA is the path clients verify against and is ALWAYS required — the repo ships
# no copy of the certificate, so fetch it from the box
# (`scp h100-dev-box-6:/nvme/work/wmo-compressor/tls/cert.pem .`). There is no fallback to the
# public CA store: the endpoint has no domain and no public CA has vouched for it.
WMO_COMPRESSOR_URL=
WMO_COMPRESSOR_API_KEY=
WMO_COMPRESSOR_CA=

# Key for OpenAI-COMPATIBLE custom endpoints (Azure Foundry resources, self-hosted vLLM).
# Used whenever an `openai`-kind provider has an explicit `endpoint` — the real OPENAI_API_KEY
# is never sent to non-OpenAI hosts. Role endpoints live in .wmo/settings.toml [models.*].
WMO_ENDPOINT_API_KEY=
