# Anthropic direct (Opus 4.8)
ANTHROPIC_API_KEY=

# AWS Bedrock (catalog provider = "bedrock"; the standard AWS chain supplies credentials)
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Azure OpenAI or Azure AI Foundry (catalog provider = "azure")
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# OpenAI direct (GPT 5.5)
OPENAI_API_KEY=

# OpenRouter (serves pool candidates like GLM-5.2 / Kimi, priced from its own catalog)
OPENROUTER_API_KEY=

# Tinker (distillation: student sampling, training, and serving trained adapters)
TINKER_API_KEY=

# E2B sandboxes (distillation rollouts and optimizer/eval runs with the e2b backend)
E2B_API_KEY=

# Hugging Face token for the pinned terminal-tasks OTLP export
HF_TOKEN=

# OpenAI-compatible custom endpoint (self-hosted vLLM or other trusted hosts).
# Native Azure connections use AZURE_OPENAI_API_KEY with their own catalog endpoint.
WMO_ENDPOINT_API_KEY=
WMO_ENDPOINT_BASE_URL=
